# Yacht Agent Environment Configuration
# ======================================
# Copy to .env and fill in with your Yacht server details.

# The base URL of your Yacht server (without /api suffix)
YACHT_SERVER_URL=https://yacht.example.com

# The enrollment token configured on your Yacht server
# (Yacht Settings → Agents → Enrollment Token)
YACHT_AGENT_ENROLLMENT_TOKEN=replace-with-your-enrollment-token

# Optional: display name for this agent host
YACHT_AGENT_NAME=remote-docker-host

# Optional: set to "false" to skip SSL verification (self-signed certs)
YACHT_AGENT_VERIFY_SSL=true

# Optional: heartbeat interval in seconds (default: 30)
YACHT_AGENT_HEARTBEAT_INTERVAL=30

# Optional: job poll interval in seconds (default: 5)
YACHT_AGENT_JOB_POLL_INTERVAL=5

# Optional: agent version for tracking
YACHT_AGENT_VERSION=1.0.0
